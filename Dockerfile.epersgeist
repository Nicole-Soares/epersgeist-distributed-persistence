FROM eclipse-temurin:21-jdk AS builder

WORKDIR /app

# Copiar todo el proyecto (incluye gradle/wrapper/gradle-wrapper.jar ahora en el repo)
COPY . .

# Convertir CRLF → LF (el gradlew viene de Windows) y dar permisos de ejecución
RUN sed -i 's/\r//' gradlew && chmod +x gradlew

RUN ./gradlew :epersgeist:bootJar --no-daemon -x test

FROM eclipse-temurin:21-jdk
WORKDIR /app

COPY --from=builder /app/epersgeist/build/libs/*.jar app.jar

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]